{
  "name": "@tokenmonitor/core",
  "version": "1.0.0",
  "private": true,
  "description": "Pure, dependency-free Claude Code usage logic shared by TokenMonitor and Aether OS. No fs, no Electron, no network.",
  "keywords": [
    "claude-code",
    "token-usage",
    "pricing"
  ],
  "license": "MIT",
  "author": "Matt Grant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwgrant21/TokenMonitorV2.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mwgrant21/TokenMonitorV2/issues"
  },
  "homepage": "https://github.com/mwgrant21/TokenMonitorV2/tree/main/packages/core#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "test": "npm run build && node --test \"test/*.test.js\" \"test/*.test.cjs\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
